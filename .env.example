# Copiez ce fichier en .env, puis collez votre clé d'équipe (sbx_...).
# Ne publiez jamais le fichier .env (il est dans .gitignore).
SAFINUM_TEAM_KEY=

# Port local du middleware.
PORT=8080

# Facultatif : la passerelle envoie déjà l'URL de la banque dans chaque requête
# (bank_api.base_url). Ne sert que si vous appelez la banque hors d'un tour.
SAFINUM_BANK_URL=

# Facultatif : Render active l'inscription automatique via render.yaml.
# En local, laissez false sauf si vous fournissez aussi une URL publique HTTPS.
SAFINUM_AUTO_REGISTER=false
SAFINUM_CHANNELS=ussd,mobile,web,sms
SAFINUM_REGISTRATION_URL=https://safinum.cm/api/v1/sandbox/endpoint
SAFINUM_PUBLIC_URL=
# Requis pour le serveur vocal (IVR) : transcription OpenAI-compatible.
VOICE_STT_API_KEY=
VOICE_STT_URL=https://api.openai.com/v1
VOICE_STT_MODEL=whisper-1
VOICE_STT_TIMEOUT_MS=6500
